{
  "compilerOptions": {
    "target": "ES2022",
    // DOM pour typer les fermetures `page.evaluate(() => ...)` des specs
    // e2e (navigator, caches...), qui s'executent dans le navigateur, pas
    // dans ce processus Node.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "tests/**/*.ts"]
}
